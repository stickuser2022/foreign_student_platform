# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 本地敏感备忘(测试账号等,绝不提交)
docs/LOCAL-DEV.md

# 后台上传的图片(本地数据,不入库;远期迁对象存储)
public/uploads/

# Playwright 无头浏览器本地产物(抓取调试用)
.playwright-mcp/

# 设计参考站截图(第三方网站内容,不入库)
design-refs/

# 数据库备份(本地保险,绝不提交)
backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/generated/
